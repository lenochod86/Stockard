{
  "expo": {
    "name": "Stockard",
    "slug": "stockard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.stockard.cards",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.stockard.cards",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0E0F13"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera se používá pouze ke skenování čárových a QR kódů vašich věrnostních karet. Nic se nikam neodesílá."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Přístup k fotkám se používá pouze pro načtení kódu z uložené fotky karty. Nic se nikam neodesílá."
        }
      ],
      "expo-sqlite"
    ]
  }
}
